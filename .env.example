# Daily Stogie environment variables.
# Copy this file to .env and fill in values. Leave everything blank to run with mock data.

# "mock" (default, no keys needed) or "supabase" (Phase 1+)
VITE_DATA_PROVIDER=mock

# Supabase (Phase 1) - Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (Phase 6) - test mode publishable key only; the secret key goes in Supabase secrets
VITE_STRIPE_PUBLISHABLE_KEY=

# Mapbox (Phase 7) - public token
VITE_MAPBOX_TOKEN=
